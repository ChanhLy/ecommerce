    "clsx": "^2.1.1",
    "drizzle-orm": "^0.33.0",
    "isbot": "^5.1.17",
    "lucide-react": "^0.441.0",
    "miniflare": "^3.20240909.1",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
